<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="3dp"
    android:background="@drawable/card_background"
    android:elevation="10dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="1dp">
<!--<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="3dp"
    android:background="@drawable/card_background"
    android:elevation="10dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="1dp">-->

    <LinearLayout
        android:id="@+id/categoryImg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:gravity="center"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleTextView"
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?android:textAppearanceSmall"
        android:textColor="#424140"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/categoryImg"/>


    <LinearLayout
        android:id="@+id/row1"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">
        <!-- Row 1 -->
        <TextView
            android:id="@+id/ts_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="start"
            android:textColor="@android:color/darker_gray"
            />

        <TextView
            android:id="@+id/ts_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@android:color/darker_gray"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toBottomOf="@id/row1">
        <!-- Row 2 -->
        <TextView
            android:id="@+id/average_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="start"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/average_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toBottomOf="@id/row2">
        <!-- Row 3 -->
        <TextView
            android:id="@+id/variance_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="start"
            android:textColor="@android:color/darker_gray" />

        <TextView
            android:id="@+id/variance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:layout_weight="1"
            android:layout_gravity="end"
            android:gravity="end"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


