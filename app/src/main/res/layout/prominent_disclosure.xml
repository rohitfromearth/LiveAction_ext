<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="5dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:gravity="center"
        android:text="@string/prominent_disclosure"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="5dp"
        android:layout_weight="0.5"
        android:backgroundTint="@color/gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/Disclosure"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom|fill_horizontal"
        android:layout_marginBottom="20dp"
        android:layout_weight="1.5"
        android:gravity="bottom"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/radiogrpp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="left"
            android:orientation="vertical">
            <LinearLayout android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                >
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="30dp"

                android:textColor="@color/gray"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                >
            <TextView
                android:id="@+id/termtextradio"
             android:layout_height="wrap_content" android:layout_width="wrap_content"
                android:text="@string/terms_condition1"/>
                <TextView
                    android:id="@+id/policytextradio"
                    android:layout_height="wrap_content" android:layout_width="wrap_content"
                    android:text="@string/privacy_policy1"/>
            </LinearLayout>
</LinearLayout>

            <RadioButton
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/disagree"
                android:textColor="@color/gray"
                android:textSize="15sp" />

        </RadioGroup>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_submit_Disclosure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_margin="10dp"
            app:cardBackgroundColor="#fe7e34"
            app:cardCornerRadius="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="5dp"
                android:text=" Accept "
                android:textStyle="bold"
                android:textFontWeight="1"
                android:textSize="20sp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>